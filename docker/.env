# Database Configuration
POSTGRES_DB=mydb
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=redis_pass
REDIS_PORT=6379

# Application Configuration
SPRING_PROFILES_ACTIVE=docker

# JWT Configuration
JWT_SECRET=myVerySecureJWTSecretKey123456789012345678901234567890
JWT_EXPIRATION=86400000

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_AUTH_WINDOW=300
RATE_LIMIT_API_REQUESTS=1000
RATE_LIMIT_API_WINDOW=60

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_LEAK_DETECTION=60000

# Redis Connection Pool Settings
REDIS_TIMEOUT=3000ms
REDIS_CONNECT_TIMEOUT=3000ms
REDIS_POOL_MAX_ACTIVE=10
REDIS_POOL_MAX_IDLE=10
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=3000ms